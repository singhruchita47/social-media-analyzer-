# ==============================================================================
# Real-Time Social Media Sentiment Analysis Platform - Environment Configuration
# ==============================================================================

# Google Gemini API Key for AI/NLP sentiment classification, keyword extraction,
# and pain-point identification.
# Get yours at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# YouTube Data API v3 Key for fetching live video comments
# Get yours at: https://console.cloud.google.com/apis/library/youtube.googleapis.com
YOUTUBE_API_KEY=your_youtube_api_key_here

# Instagram RapidAPI / Graph API Key for fetching live Instagram media comments
INSTAGRAM_ACCESS_TOKEN=your_instagram_rapidapi_key_here
RAPIDAPI_KEY=your_instagram_rapidapi_key_here
RAPIDAPI_INSTAGRAM_HOST=instagram-scraper-stable-api.p.rapidapi.com

# Backend Server Settings
DATABASE_PATH=./sentiment_hub.db
PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000
