# ==============================================================================
# Real-Time Social Media Sentiment Analysis Platform - Environment Configuration
# ==============================================================================

# 1. Anthropic Claude 3.5 Sonnet API Key (Primary LLM for Sarcasm & Hinglish NLP)
# Get yours at: https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# 2. OpenAI GPT-4o API Key (Secondary LLM Option)
# Get yours at: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o

# 3. Google Gemini API Key (Tertiary LLM Option)
# Get yours at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# 4. YouTube Data API v3 Key for Full Paginated Comment Fetching (100+ comments via nextPageToken)
# Get yours at: https://console.cloud.google.com/apis/library/youtube.googleapis.com
YOUTUBE_API_KEY=your_youtube_api_key_here

# 5. Instagram RapidAPI / Graph API Key for Live Instagram Media Comments
INSTAGRAM_ACCESS_TOKEN=your_instagram_rapidapi_key_here
RAPIDAPI_KEY=your_instagram_rapidapi_key_here
RAPIDAPI_INSTAGRAM_HOST=instagram-scraper-stable-api.p.rapidapi.com

# 6. Database Configuration (MongoDB URI + Local SQLite Fallback)
MONGO_URI=mongodb://localhost:27017/social_sentiment_hub
MONGO_DB_NAME=social_sentiment_hub
DATABASE_PATH=./sentiment_hub.db

# 7. Backend Server Settings
PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000
